
Now, I'll integrate the new Reddit builder into the main build logic.

```filepath=bridge-template/forge-builder.js instruction="I am updating the main build dispatcher, `forge-builder.js`, to import and use the new `reddit-builder.js` for 'reddit' platform requests."
const path = require("path");
const { buildDesktop } = require("./desktop-builder");
const { buildAndroid } = require("./android/android-builder");
const { buildReddit } = require("./reddit-builder");

async function buildWithForge(opts, ws) {
    if (opts.platform === "android") {
        return await buildAndroid(opts, ws);
    }
    if (opts.platform === "reddit") {
        return await buildReddit(opts, ws);
    }
    return await buildDesktop(opts, ws);
}

module.exports = { buildWithForge };

