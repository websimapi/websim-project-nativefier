filepath=bridge-template/reddit-builder.js instruction="Creating the new `reddit-builder.js` file, which correctly scaffolds a Devvit project that iframes the user's web app."
const fs = require("fs");
const path = require("path");
const { rimraf } = require("rimraf");
const JSZip = require("jszip");

async function buildReddit(opts, ws) {
    const { url, appName = "MyApp", outputDir, distDir, requestId } = opts;
    const safeName = (appName || "MyApp").replace(/[^a-zA-Z0-9.-]/g, "") || "MyApp";
    const workDir = path.join(outputDir, `${safeName}-reddit-${Date.now()}`);
    
    const msg = (m) => ws && ws.send(JSON.stringify({ type: 'build_progress', message: m, requestId }));

    try {
        msg("Initializing Devvit project structure...");
        fs.mkdirSync(workDir, { recursive: true });

        const safePkgName = safeName.toLowerCase().replace(/[^a-z0-9-]/g, '');

        // package.json
        const pkg = {
            name: safePkgName,
            version: "0.1.0",
            private: true,
            scripts: {
                "dev": "devvit dev",
                "build": "devvit build",
                "upload": "devvit upload"
            },
            dependencies: {
                "@devvit/public-api": "0.11.13",
                "react": "^18.2.0"
            },
            devDependencies: {
                "@devvit/dev-vit": "0.11.13",
                "typescript": "^5.2.2"
            }
        };
        fs.writeFileSync(path.join(workDir, "package.json"), JSON.stringify(pkg, null, 2));

        // devvit.json
        const devvitJson = {
            name: safeName,
            version: "0.1.0"
        };
        fs.writeFileSync(path.join(workDir, "devvit.json"), JSON.stringify(devvitJson, null, 2));

        // tsconfig.json
        const tsConfig = {
            "compilerOptions": {
                "target": "ESNext",
                "module": "ESNext",
                "moduleResolution": "node",
                "resolveJsonModule": true,
                "isolatedModules": true,
                "noEmit": true,
                "jsx": "react-jsx",
                "strict": true,
            },
            "include": ["src"],
        };
        fs.writeFileSync(path.join(workDir, 'tsconfig.json'), JSON.stringify(tsConfig, null, 2));
        
        // src folder and files
        const srcDir = path.join(workDir, 'src');
        fs.mkdirSync(srcDir, { recursive: true });

        // src/main.ts (Server-side)
        const mainTs = `
import { Devvit } from '@devvit/public-api';

Devvit.configure({
  redditAPI: true,
  http: true, // Enable HTTP requests
});

// Create a custom post that will render our web app
Devvit.addCustomPostType({
  name: 'WebAppPost',
  render: context => {
    // The client-side app is rendered here in an iframe.
    return (
      <blocks height="tall">
        <webview url="./index.html" />
      </blocks>
    );
  },
});

export default Devvit;
`;
        fs.writeFileSync(path.join(srcDir, 'main.ts'), mainTs.trim());

        // src/main.css (Client-side styling)
        const mainCss = `
body, html, #root {
  margin: 0;
  padding: 0;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background-color: #ffffff;
  display: flex;
}
iframe {
  flex-grow: 1;
  border: none;
}
`;
        fs.writeFileSync(path.join(srcDir, 'main.css'), mainCss.trim());

        // src/main.tsx (Client-side React component)
        const mainTsx = `
import { Devvit } from '@devvit/public-api';
import React from 'react';
import './main.css';

const App = () => {
  return (
    <iframe src="${url}" title="${safeName}" />
  );
};

Devvit.render(App);
`;
        fs.writeFileSync(path.join(srcDir, 'main.tsx'), mainTsx.trim());

        msg("Packaging Devvit project files...");
        const outName = `${safePkgName}_devvit_${Date.now()}.zip`;
        const dest = path.join(distDir, outName);
        
        const zip = new JSZip();
        
        function addFolderToZip(zipFolder, folderPath, root = '') {
            fs.readdirSync(folderPath).forEach(file => {
                const fullPath = path.join(folderPath, file);
                const zipPath = path.join(root, file);
                if (fs.lstatSync(fullPath).isDirectory()) {
                    addFolderToZip(zipFolder.folder(file), fullPath, zipPath);
                } else {
                    zipFolder.file(zipPath, fs.readFileSync(fullPath));
                }
            });
        }
        
        const zipRoot = zip.folder(safePkgName);
        addFolderToZip(zipRoot, workDir);

        const zipContent = await zip.generateAsync({ type: "nodebuffer" });
        fs.writeFileSync(dest, zipContent);

        return { artifactPath: dest, fileName: outName };

    } finally {
        await rimraf(workDir);
    }
}

module.exports = { buildReddit };

